# ==========================================
# Nimbus - Development Environment
# ==========================================

# ------------------------------------------
# Application
# ------------------------------------------

NODE_ENV=development

# Backend
BACKEND_PORT=3000

# Frontend / Vite
FRONTEND_PORT=5173

# ------------------------------------------
# PostgreSQL
# ------------------------------------------

POSTGRES_DB=nimbus
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Backend database connection
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=nimbus
DATABASE_USER=nimbus
DATABASE_PASSWORD=change_me

# ------------------------------------------
# GitHub OAuth
# ------------------------------------------
# Add these later when GitHub OAuth is implemented.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=

# OAuth callback through Nginx
GITHUB_CALLBACK_URL=http://localhost/api/v1/auth/github/callback

# ------------------------------------------
# Nimbus
# ------------------------------------------

NIMBUS_BASE_URL=http://localhost